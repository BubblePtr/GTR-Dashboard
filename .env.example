# GTR Dashboard — API Keys
# Copy this file to `.env` and fill in your keys

# Tavily API Key — for AI-powered web search and content extraction
# Get one free at: https://tavily.com
TAVILY_API_KEY=

# Exa API Key — for semantic search (discovering hidden gems)
# Get one free at: https://exa.ai
EXA_API_KEY=

# LLM API Key — used by the profiler and strategist agents
# Default: DashScope (通义千问) via OpenAI-compatible API
# Get one free at: https://bailian.console.aliyun.com
# 如果要改用 OpenAI，直接填入 OpenAI API Key 即可
OPENAI_API_KEY=

# LLM API Base URL — OpenAI-compatible endpoint
# Default: DashScope 国内节点
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 若要使用 OpenAI 官方接口，取消下行注释：
# OPENAI_BASE_URL=https://api.openai.com/v1
